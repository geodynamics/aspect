
set Output directory         = output-rotation-average-orthorhombic
set Dimension                              = 2

set Use years instead of seconds           = false
set End time                               = 0.15
set Pressure normalization                 = surface
set Surface pressure                       = 0
set Nonlinear solver tolerance             = 1e-5

# # # Configuration of a 2D convection box # # #

subsection Solver parameters
  set Temperature solver tolerance = 1e-7
  subsection Stokes solver parameters
    set Linear solver tolerance = 1e-6
  end
end

subsection Geometry model
  set Model name = box

  subsection Box
    set X extent = 1
    set Y extent = 1
    set Box origin X coordinate = -0.5
    set Box origin Y coordinate = -0.5
  end
end

subsection Initial temperature model
  set List of model names = function

  subsection Function
    set Variable names      = x,z
    set Function constants  = p=0.01, L=1, pi=3.1415926536, k=1
    set Function expression = (0.5-z) - p*cos(k*pi*(x+0.5)/L)*sin(pi*(z+0.5))
  end
end

subsection Boundary temperature model
  set Fixed temperature boundary indicators = bottom, top
  set List of model names = box

  subsection Box
    set Bottom temperature = 1
    set Left temperature   = 0
    set Right temperature  = 0
    set Top temperature    = 0
  end
end

subsection Boundary velocity model
  set Tangential velocity boundary indicators = left, right, bottom, top
end

subsection Gravity model
  set Model name = vertical

  subsection Vertical
    set Magnitude = 1e4   # = Ra
  end
end

subsection Material model
  set Model name = simple

  subsection Simple model
    set Reference density             = 1
    set Reference specific heat       = 1
    set Reference temperature         = 0
    set Thermal conductivity          = 1
    set Thermal expansion coefficient = 1
    set Viscosity                     = 1
  end
end

subsection Formulation
  set Formulation = Boussinesq approximation
end

# # # Mesh refinement # # #

# we set an 8x8 grid and omit mesh refinement
subsection Mesh refinement
  set Initial global refinement                = 3
  set Initial adaptive refinement              = 0
  set Time steps between mesh refinement       = 0
end

# # # Compositional fields # # #

# The quaternions output by the bingham average are interpolated to the grid
# Quaternions can be written with a scalar part q.w
# and a vector part (q.n) or (q.x, q.y, q.z)
# The field "eigenvalue a1" is there to use the base interpolation scheme on one other field
# It also tells us about how "peaked" the distribution for the a-axis is
# or in other words how well the a-axes align.
# water is required for the drex algorithm to work.
subsection Compositional fields
  set Number of fields = 6
  set Names of fields = qw, qx, qy, qz, \
                        eigvalue_a1, water
  set Compositional field methods = particles, particles, particles, particles, \
                                    particles, static
  set Mapped particle properties = qw:cpo mineral 0 q.w[0], qx:cpo mineral 0 q.n[0], qy:cpo mineral 0 q.n[1], qz:cpo mineral 0 q.n[2], eigvalue_a1:cpo mineral 0 eigenvalues a axis[0]
  set Types of fields = generic, generic, generic, generic, \
                        generic, generic
end

subsection Initial composition model
  set List of model names = function

  subsection Function
    set Function expression = 1; 0; 0; 0;\
                              1/3; 0
  end
end

# # # Discretization # # #

# for quaternions it is recommended to use discontinuous degree 0 polynomials
# in other words a constant value per cell
# this ensures that we recover a proper rotation after interpolation
# we can set different discretization and polynomial degrees
# for the properties that are not quaternions if we want to
subsection Discretization
  set Composition polynomial degree = 0, 0, 0, 0, \
                                      2, 0
  set Use discontinuous composition discretization = true, true, true, true, \
                                                     false, true,
end

# # # Post Process # # #

# We use particles to track the crystal preferred orientation
subsection Postprocess
  set List of postprocessors = visualization, particles, crystal preferred orientation

  subsection Visualization
    set Time between graphical output = 0.01
    set List of output variables = strain rate
  end

  # Do not output the particle cpo more than once and compress it
  # if you are not interested in the detailed cpo.
  subsection Crystal Preferred Orientation
    set Time between data output = 1
    set Write in background thread = true
    set Compress cpo data files = true
    set Write out raw cpo data = mineral 0: volume fraction, mineral 0: Euler angles
    set Write out draw volume weighted cpo data =
  end

  subsection Particles
    set Time between data output = 0.01
    set Data output format       = vtu
    set Exclude output properties = volume fraction, rotation_matrix
  end
end

# # # Particles # # #

# The Bingham average and crystal preferred orientation plugins are required
# to generate an "average" crystal orientation on each particle.
# This rotation is stored as a quaternion and interpolated as one object to the grid
# using the quaternion average interpolator.
# The integrated strain invariant can give us information about how much strain accumulated.
# In normal geodynamic settings the maximum strain is around 15.
subsection Particles
  set List of particle properties = crystal preferred orientation, cpo bingham average, integrated strain invariant
  set Interpolation scheme          = quaternion average
  # The interpolator allows using a base interpolation scheme
  # for all properties that are not quaternions.
  # One can also define the symmetry group of the crystal orientation,
  # which is supposed to be averaged.
  # Currently, orthorhombic and triclinic are supported.
  # Triclinic gives a well established rotation average and
  # orthorhombic uses the algorithm described in the doc file.
  subsection Interpolator
    subsection Quaternion average
      set Base interpolation scheme = linear least squares
      set Symmetry group            = orthorhombic
    end
  end

  # Cells without particles are currently not supported.
  # A particle generator that is not random uniform is recommended
  # to avoid a cell with zero particles in the zeroth timestep.
  # We also need a relatively high number of particles per cell.
  set Particle generator name       = reference cell
  set Minimum particles per cell    = 6
  set Maximum particles per cell    = 7
  set Load balancing strategy       = remove and add particles

  subsection Crystal Preferred Orientation
    set Random number seed = 301
    set Number of grains per particle = 500
    set Property advection method = Backward Euler
    set Property advection tolerance = 1e-10
    set CPO derivatives algorithm = D-Rex 2004

    subsection Initial grains
      set Minerals = Olivine: A-fabric
      set Volume fractions minerals = 1
    end

    # We run fabric evolution with Drex.
    # The Mobility and Nucleation efficiency are set to zero
    # to exclude dynamic recrystallization
    # which can cause complex cpo at high strain.
    subsection D-Rex 2004
      set Mobility = 0 # 10
      set Stress exponents = 3.5
      set Exponents p = 1.5
      set Nucleation efficiency = 0 #5
      set Threshold GBS = 0.3
    end
  end

  # Output the bingham average rotation as quaternions.
  # A seed is added for reproducibility.
  subsection CPO Bingham Average
    set Random number seed = 200
    set output rotation as = quaternion
  end
end
