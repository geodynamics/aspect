set Dimension                              = 2
set Additional shared libraries            = ./libflamant_solution.so
set End time                               = 1e3
set Use years instead of seconds           = true
set Adiabatic surface temperature          = 1600
set Surface pressure                       = 0
set Pressure normalization                 = no
set Nonlinear solver scheme                = iterated Advection and Stokes
set Nonlinear solver tolerance             = 1e-5
set Max nonlinear iterations               = 25
set Output directory                       = elastic_line_load_compressible
set Use operator splitting                 = false

# This calculates the adiabatic temperature profile down the model and is used
# by the initial temperature and composition models.
subsection Adiabatic conditions model
  subsection Compute profile
    set Number of points              = 100
    set Composition reference profile = initial composition
  end
end

subsection Solver parameters
  subsection Stokes solver parameters
    set Linear solver tolerance = 1e-12
  end

  subsection Operator splitting parameters
    set Reaction solver type                   = fixed step
    set Reaction time steps per advection step = 10
    set Reaction time step                     = 100
  end
end

subsection Discretization
  set Use discontinuous composition discretization = true
end

subsection Compositional fields
  set Number of fields            = 7
  set Names of fields             = density_field, ve_stress_xx, ve_stress_yy, ve_stress_xy, ve_stress_xx_old, ve_stress_yy_old, ve_stress_xy_old
  set Compositional field methods = prescribed field, particles, particles, particles, particles, particles, particles
  set Types of fields             = density, stress, stress, stress, stress, stress, stress
  set Mapped particle properties  = ve_stress_xx: ve_stress_xx, \
                                    ve_stress_yy: ve_stress_yy, \
                                    ve_stress_xy: ve_stress_xy, \
                                    ve_stress_xx_old: ve_stress_xx_old, \
                                    ve_stress_yy_old: ve_stress_yy_old, \
                                    ve_stress_xy_old: ve_stress_xy_old
end

subsection Particles
  set Minimum particles per cell  = 50
  set Maximum particles per cell  = 100
  set Load balancing strategy     = remove and add particles
  set List of particle properties = elastic stress
  set Interpolation scheme        = bilinear least squares
  set Particle generator name     = reference cell
  subsection Generator
    subsection Reference cell
      set Number of particles per cell per direction = 7
    end
  end
end

subsection Initial composition model
  set List of model names =  adiabatic density, function
  subsection Function
    set Variable names      = x,y
    set Function expression = 0; 0; 0; 0; 0; 0; 0
  end
end

# This section contains the functionality tested by this model. The projected density approximation
# is the preferred compressibility formulation, as demonstrated by
# the compressibility formulations benchmark (Gassmoeller et al.).
# Use the projected density approximation for the compressibility formation,
# which is the key functionality being tested by this model.
subsection Formulation
  set Mass conservation    = projected density field
  set Temperature equation = real density
  set Enable elasticity    = true
end

# 1x1 m box with a 2x2 grid (which is the minimum)
# there are no global or adaptive refinement steps
# so this is the initial and end resolution.
subsection Geometry model
  set Model name = box

  subsection Box
    set Y extent = 300e3
    set X extent = 600e3
    set X repetitions = 60
    set Y repetitions = 30
  end
end

# We only want to evaluate the density resulting from the applied surface
# pressure, so we disable gravity.
subsection Gravity model
  set Model name = vertical

  subsection Vertical
    set Magnitude = 0.0
  end

end

############### Boundary conditions
# We fix the temperature on all boundaries, and as our model is so small this
# prescribes the temperature throughout the model.
subsection Boundary temperature model
  set Fixed temperature boundary indicators = left, right, top, bottom
  set List of model names = initial temperature
end

# We allow free slip on all sides
subsection Boundary velocity model
  set Tangential velocity boundary indicators = bottom, left, right
end

subsection Boundary traction model
  set Prescribed traction boundary indicators = top: function
  subsection Function
    set Variable names      = x,y
    # set Function expression = 0; if(x<=170e3 & x>=130e3, -1e3, 0)
    set Function expression = 0; if(x<=320e3 & x>=280e3, -2.7e6, 0)

  end
end

subsection Initial temperature model
  set Model name = function
  subsection Function
    set Function expression = 500
  end
end

subsection Material model
  set Model name = compositing

  subsection Multicomponent compressible
    set Reference temperatures                       = 293
    set Viscosities                                  = 1e20
    set Reference densities                          = 2700
    set Reference isothermal compressibilities       = 4e-11
    set Isothermal bulk modulus pressure derivatives = 4
    set Reference thermal expansivities              = 0
    set Isochoric specific heats                     = 1250
    set Thermal conductivities                       = 0
  end

  subsection Visco Plastic
    set Viscous flow law                        = diffusion
    set Activation energies for diffusion creep = 0
    set Activation volumes for diffusion creep  = 0
    set Minimum viscosity                       = 1e20
    set Maximum viscosity                       = 1e20
    set Fixed elastic time step                 = 1e3
    set Elastic shear moduli                    = 1e10
    set Use fixed elastic time step             = true
    set Cohesions                               = 1e100
  end

  subsection Compositing
    set Viscosity                      = visco plastic
    set Density                        = multicomponent compressible
    set Thermal expansion coefficient  = multicomponent compressible
    set Specific heat                  = multicomponent compressible
    set Thermal conductivity           = multicomponent compressible
    set Compressibility                = multicomponent compressible
    set Entropy derivative pressure    = multicomponent compressible
    set Entropy derivative temperature = multicomponent compressible
    set Reaction terms                 = multicomponent compressible
  end
end

# We want to keep the mesh static
subsection Mesh refinement
  set Initial adaptive refinement        = 0
  set Initial global refinement          = 3
  set Time steps between mesh refinement = 0
  set Strategy                           = minimum refinement function
  subsection Minimum refinement function
    set Variable names      = x,y
    set Function expression = if(y>=150e3, 3, 0)
  end
end

subsection Postprocess
  set List of postprocessors = material statistics, composition statistics, visualization

  subsection Visualization
    set Output format                 = vtu
    set Point-wise stress and strain  = true
    set Time between graphical output = 0
    set List of output variables      = material properties, shear stress, stress, flamant analytic stress
  end
end
