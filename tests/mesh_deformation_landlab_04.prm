# Test the function "evaluate_derived_quantities_at_points" by
# setting up a simple shear box and printing the strain rate 
# from the Landlab side.
#
# Enable if: ASPECT_WITH_LANDLAB
# MPI: 1

set Dimension                              = 3
set Use years instead of seconds           = false
set End time                               = 0.0005
set Maximum time step                      = 0.0005
set Nonlinear solver scheme                = single Advection, single Stokes
set Pressure normalization                 = surface
set Surface pressure                       = 0
set Output directory                       = output

subsection Geometry model
  set Model name = box

  subsection Box
    set X extent = 80e3
    set Y extent = 80e3
    set Z extent = 80e3
  end
end

# Temperature effects are ignored
subsection Initial temperature model
  set List of model names = function

  subsection Function
    set Function expression = 1000
  end
end

subsection Boundary temperature model
  set Fixed temperature boundary indicators = bottom, top
  set List of model names = initial temperature
end

# Apply a simple shear boundary condition
subsection Boundary velocity model
  set Prescribed velocity boundary indicators = right: function, left: function, bottom: function, front: function, back: function
  subsection Function
    set Coordinate system =  cartesian
    set Variable names = x,y,z
    set Function constants = mag=1e-8, middle=40e3, width=80e3
    set Function expression = mag * (z - middle) / width ; 0.0 ; 0.0
  end
end

subsection Mesh deformation
  set Mesh deformation boundary indicators = top: landlab
  set Additional tangential mesh velocity boundary indicators = left, right
  subsection Landlab
    set Script name = mesh_deformation_landlab_strain_rate
    set Script path = $ASPECT_SOURCE_DIR/tests/

    # Test that the strain rate is being sent to Landlab
    set List of additional ASPECT quantities = strain rate
  end
end

# Vertical gravity
subsection Gravity model
  set Model name = vertical
  subsection Vertical
    set Magnitude = 1
  end
end

# Isoviscous material
subsection Material model
  set Model name = visco plastic

  subsection Visco Plastic
    set Minimum viscosity = 1e21
    set Maximum viscosity = 1e21
  end
end

# We here use a globally refined mesh without
# adaptive mesh refinement.
subsection Mesh refinement
  set Initial global refinement                = 3
  set Initial adaptive refinement              = 0
  set Time steps between mesh refinement       = 0
end

subsection Postprocess
  set List of postprocessors = 
end
