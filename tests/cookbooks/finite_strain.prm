# This test makes sure the cookbook finite_strain runs
# as expected.

set Additional shared libraries            =
set Dimension                              = 2

include $ASPECT_SOURCE_DIR/cookbooks/finite_strain/finite_strain.prm

set End time                               = 0

subsection Mesh refinement
  set Initial adaptive refinement        = 0
  set Initial global refinement          = 1
  set Time steps between mesh refinement = 0
end

subsection Postprocess
  set List of postprocessors = composition statistics, velocity statistics, temperature statistics
end
