# This test makes sure the cookbook lower_crustal_flow_obstacle runs
# as expected.

set Dimension                              = 3

include $ASPECT_SOURCE_DIR/cookbooks/lower_crustal_flow/lower_crustal_flow_obstacle.prm

set End time                               = 0

subsection Mesh refinement
  set Initial adaptive refinement        = 0
  set Initial global refinement          = 0
  set Minimum refinement level           = 0
end

subsection Postprocess
  set List of postprocessors = velocity statistics, pressure statistics
end
