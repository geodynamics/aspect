# This test checks that the zero solubility reaction model conserves
# water during fluid release. Initially, the solid contains 1 wt% bound
# water and the porosity is 1% (volume fraction).
# With solid and fluid densities of 3000 and 2000 kg/m^3, respectively,
# the bulk density is 2990 kg/m^3. The total water mass fraction is
# (0.99 * 3000 * 0.01 + 0.01 * 2000) / 2990 = 0.0166220735786.
# After complete release, the bound water content is zero and the
# porosity is 3000 * 0.0166220735786 /
# (2000 + (3000 - 2000) * 0.0166220735786) = 0.024727598388.
# The equilibrium free fluid mass fraction must remain unchanged.
include $ASPECT_SOURCE_DIR/tests/reactive_fluid_transport_zero_solubility.prm

set End time = 10e3

subsection Solver parameters
  subsection Operator splitting parameters
    set Reaction solver type = fixed step
    set Reaction time step   = 1000
  end
end

subsection Gravity model
  set Model name = vertical

  subsection Vertical
    set Magnitude = 0.0
  end
end

subsection Initial composition model
  subsection Function
    set Function expression = 0.01; 0.01
  end
end

# Use the zero solubility scheme in the reactive fluid
# transport model.
subsection Material model
  subsection Reactive Fluid Transport Model
    set Reference fluid density = 2000
    set Fluid reaction time scale for operator splitting = 1000
  end
end

subsection Postprocess
  set List of postprocessors = melt statistics, composition statistics
end
