# Copy of visco_plastic_phases_compositions.prm,
# but use different thermal conductivities
# for different compositions and phases.

include $ASPECT_SOURCE_DIR/tests/visco_plastic_phases_compositions.prm

subsection Mesh refinement
  set Initial global refinement          = 1
end

subsection Material model
  subsection Visco Plastic
    set Define thermal conductivities = true
    set Thermal conductivities = upper_crust: 3.0|2.0, lower_crust: 2.0, background: 3.0|2.0|1.0
  end
end

subsection Postprocess
  set List of postprocessors = velocity statistics, mass flux statistics, visualization, material statistics

  subsection Visualization
    set Interpolate output            = false
    set Output format                 = gnuplot
    set List of output variables      = material properties

    subsection Material properties
      set List of material properties   = thermal conductivity, thermal diffusivity
    end
  end
end
