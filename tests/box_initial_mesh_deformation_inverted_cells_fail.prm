# This input file tests that the mesh deformation handler aborts with a
# meaningful error message when the prescribed initial topography is so
# steep that the initial (Laplace) mesh deformation turns cells inside out,
# i.e. produces cells with a negative Jacobian determinant.
#
# See https://github.com/geodynamics/aspect/issues/7337. Previously the
# model silently continued with an ill-defined (inverted) mesh.
#
# The top boundary is deformed by a discontinuous (step-like) initial
# topography that jumps by 10000 m, which is more than three cell sizes
# (1562.5 m) within a single cell. This is steep enough that the deformed
# mesh contains inverted cells, so the run is expected to fail.

# MPI: 1
# EXPECT FAILURE

set Dimension                              = 2
set Use years instead of seconds           = true
set End time                               = 0
set Start time                             = 0

set Nonlinear solver scheme                = no Advection, no Stokes
set Pressure normalization                 = surface
set Surface pressure                       = 0

subsection Geometry model
  set Model name = box

  subsection Box
    set Box origin X coordinate = 0
    set Box origin Y coordinate = 0

    set X extent = 100e3
    set Y extent = 25e3

    # 2.5 x 2.5 km uniform coarse mesh
    set X repetitions = 4
    set Y repetitions = 1
  end
end

# Temperature effects are ignored
subsection Initial temperature model
  set List of model names = function
  subsection Function
    set Function expression = 273
  end
end

subsection Boundary temperature model
  set Fixed temperature boundary indicators = bottom, top
  set List of model names = initial temperature
end

# Free slip on all boundaries
subsection Boundary velocity model
  set Tangential velocity boundary indicators = left, right, bottom
end

# The initial mesh deformation is prescribed on the top boundary from an
# ascii data file containing a step-like (discontinuous) topography.
subsection Mesh deformation
  set Mesh deformation boundary indicators = top: ascii data
  set Additional tangential mesh velocity boundary indicators = left, right

  subsection Ascii data model
    set Data directory = $ASPECT_SOURCE_DIR/data/geometry-model/initial-topography-model/ascii-data/test/
    set Data file name = box_2d_top_step.0.txt
  end
end

# Vertical gravity
subsection Gravity model
  set Model name = vertical

  subsection Vertical
    set Magnitude = 1
  end
end

# One material with unity properties
subsection Material model
  set Model name = simple

  subsection Simple model
    set Reference density             = 1
    set Reference specific heat       = 1
    set Reference temperature         = 0
    set Thermal conductivity          = 1
    set Thermal expansion coefficient = 1
    set Viscosity                     = 1
  end
end

# We also have to specify that we want to use the Boussinesq
# approximation.
subsection Formulation
  set Formulation = Boussinesq approximation
end

# We here use a globally refined mesh without
# adaptive mesh refinement.
subsection Mesh refinement
  set Initial global refinement                = 4
  set Initial adaptive refinement              = 0
  set Time steps between mesh refinement       = 0
end

subsection Postprocess
  set List of postprocessors = topography, velocity statistics
end
