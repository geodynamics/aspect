# Test global coarsening GMG with a curved mesh and no normal flux (tangential)
# boundary conditions. This checks that a correct mapping is used on the
# multigrid levels.
#
# MPI: 5

set Dimension = 3
set End time = 0
set Nonlinear solver scheme = no Advection, single Stokes

subsection Geometry model
  set Model name = chunk

  subsection Chunk
    set Chunk inner radius = 3.481e6
    set Chunk outer radius = 6.371e6
    set Chunk maximum longitude = 61.0
    set Chunk minimum longitude = 0.0
    set Chunk maximum latitude = 61.0
    set Chunk minimum latitude = 0.0
    set Longitude repetitions = 2
    set Latitude repetitions = 2
  end
end

subsection Material model
  set Model name = simple

  subsection Simple model
    set Viscosity = 1e22
  end
end

subsection Boundary velocity model
  set Zero velocity boundary indicators = 0, 1, 2, 3
  set Tangential velocity boundary indicators = 4, 5
end

subsection Initial temperature model
  set List of model names = function

  subsection Function
    set Function expression = z
  end
end

subsection Gravity model
  set Model name = radial constant
end

subsection Mesh refinement
  set Initial global refinement = 2
  set Initial adaptive refinement = 5
  set Strategy = temperature
  set Skip solvers on initial refinement = true
end

subsection Solver parameters
  subsection Stokes solver parameters
    set Stokes solver type = block GMG
    set Stokes GMG type = global coarsening
  end
end
