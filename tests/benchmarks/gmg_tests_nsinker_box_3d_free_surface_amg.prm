# Coarse AMG test for the free-surface nsinker box case.
include $ASPECT_SOURCE_DIR/benchmarks/gmg-tests/nsinker-box-3d/free-surface.prm

subsection Mesh refinement
  set Initial global refinement   = 1
  set Initial adaptive refinement = 1
end

subsection Solver parameters
  subsection Stokes solver parameters
    set Stokes solver type = block AMG
  end
end

subsection Mesh deformation
  subsection Ascii data model
    set Data directory = $ASPECT_SOURCE_DIR/benchmarks/gmg-tests/nsinker-box-3d
  end
end
