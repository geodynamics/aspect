# Exercise local-smoothing GMG with rotated 180-degree periodicity. This test
# uses a uniform mesh to isolate the level-periodicity constraints; separate
# particle tests cover compatible adaptive refinement.

include $ASPECT_SOURCE_DIR/tests/spherical_shell_periodic_gmg_180.prm

set Output directory = output-spherical-shell-periodic-gmg-local-smoothing-180

subsection Mesh refinement
  set Initial adaptive refinement        = 0
  set Time steps between mesh refinement = 0
end

subsection Solver parameters
  subsection Stokes solver parameters
    set Stokes solver type = block GMG
    set Stokes GMG type    = local smoothing
  end
end
# Enable if: DEAL_II_VERSION_GTE_9_9_0
